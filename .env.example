# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here
# Explicit comma-separated UUIDs for connected organisations allowed by this server.
# Configure this locally before using accounting read tools; no first-tenant fallback.
XERO_ALLOWED_TENANT_IDS=

# Optional durable OAuth mode: existing approved grant, private mounted state/key.
# Do not combine with XERO_CLIENT_BEARER_TOKEN. Key must be base64, 32 bytes, mode 0600.
XERO_TOKEN_FILE=
XERO_TOKEN_KEY_FILE=

# Optional authenticated remote transport. Keep stdio unless explicitly selected.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_KEYCLOAK_ISSUER=
MCP_RESOURCE_URL=
MCP_AUDIENCE=
MCP_READ_SCOPE=xero:read
# JSON: Keycloak subject IDs -> explicit allowed tenant UUID arrays.
MCP_SUBJECT_TENANTS_JSON={}
# Comma-separated HTTPS browser origins; omitted means no browser origins allowed.
MCP_ALLOWED_ORIGINS=
